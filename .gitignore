# Build artifacts and binaries
obj/
bin/
*.o
*.out
*.exe

# Memory profiling and Valgrind outputs
vgcore.*
callgrind.out.*

# Python environment and cache (for the fuzzer scripts)
__pycache__/
*.pyc
.venv/
venv/

# Ignore all generated results logs, but keep the directory tracked
results/*.log
results/*.txt
!results/.gitkeep